{
  "name": "eclipse-client",
  "version": "1.0.0",
  "description": "Eclipse Client",
  "main": "src/main/main.js",
  "author": "KNeo24",
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build:dir": "electron-builder --dir",
    "build:win": "electron-builder --win nsis --x64",
    "build:mac": "electron-builder --mac dmg",
    "build:linux": "electron-builder --linux AppImage",
    "dist": "electron-builder",
    "push": "node scripts/git-push.js --start",
    "push:single": "node scripts/git-push.js"
  },
  "dependencies": {
    "discord-rpc": "4.0.1",
    "electron-updater": "6.3.9",
    "minecraft-launcher-core": "3.18.2",
    "msmc": "^5.0.5",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "electron": "35.0.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "cc.wawe.knoe24.eclipseclient",
    "productName": "Eclipse Client",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
"files": [
  "src/**/*",
  "node_modules/skinview3d/bundles/**/*",
  "package.json"
],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Eclipse Client"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://launcher.wawe.cc/launcher/updates/"
      }
    ]
  }
}
