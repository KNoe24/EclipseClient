{
  "name": "eclipse-client",
  "version": "1.0.1",
  "description": "Eclipse Client",
  "main": "src/main/main.js",
  "author": "KNeo24",
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build:dir": "electron-builder --dir",
    "build:win": "electron-builder --win nsis portable --x64 && node scripts/make-portable-manifest.js",
    "build:mac": "electron-builder --mac dmg",
    "build:linux": "electron-builder --linux AppImage",
    "dist": "electron-builder",
    "push": "node scripts/git-push.js --start",
    "push:p": "node scripts/git-push.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build:portable": "electron-builder --win portable --x64 && node scripts/make-portable-manifest.js",
    "release": "node scripts/release.js",
    "release:dry": "node scripts/release.js --dry-run"
  },
  "dependencies": {
    "discord-rpc": "4.0.1",
    "electron-updater": "6.3.9",
    "minecraft-launcher-core": "3.18.2",
    "msmc": "^5.0.5",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "electron": "35.0.0",
    "electron-builder": "25.1.8",
    "prettier": "^3.8.3"
  },
  "build": {
    "appId": "cc.wawe.knoe24.eclipseclient",
    "productName": "Eclipse Client",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "node_modules/skinview3d/bundles/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Eclipse Client"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://raw.githubusercontent.com/KNoe24/eclipse-updates/launcher/"
      }
    ],
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "release": {
    "updatesRepo": "https://github.com/KNoe24/eclipse-updates.git",
    "branch": "launcher"
  }
}
